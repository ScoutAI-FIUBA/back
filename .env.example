# ===== Auth (required) =====
AUTH_JWT_SECRET=replace-with-dev-jwt-secret
AUTH_REFRESH_SECRET=replace-with-dev-refresh-secret
AUTH_JWT_ISSUER=scoutai-local
AUTH_JWT_AUDIENCE=scoutai-local-client

# ===== Database (required) =====
# Local docker-compose uses these credentials directly:
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/scoutai_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scoutai_dev

# In production (Supabase), use the Connection Pooler URL on port 6543:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ===== HTTP =====
# Used in production (APP_ENV=production). In local dev, any localhost port is allowed.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ===== Storage: Cloudflare R2 (optional - lazy init) =====
# Leave empty to skip R2 wiring. Required only when using storage features.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
