# ===== Auth (required) =====
AUTH_JWT_SECRET=replace-with-dev-jwt-secret
AUTH_REFRESH_SECRET=replace-with-dev-refresh-secret
AUTH_JWT_ISSUER=scoutai-local
AUTH_JWT_AUDIENCE=scoutai-local-client

# ===== Database (required) =====
# Local docker-compose uses these credentials directly:
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/scoutai_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scoutai_dev

# In production (Supabase), use the Connection Pooler URL on port 6543:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ===== HTTP =====
# Used in production (APP_ENV=production). In local dev, any localhost port is allowed.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Refresh cookie SameSite. Defaults: strict (dev), none (production cross-origin).
# AUTH_COOKIE_SAMESITE=strict

# ===== Storage: Cloudflare R2 (optional - client created on first use) =====
# Leave empty to skip R2 wiring. Required only when using storage features.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# ===== Video processing service (optional) =====
# The GPU service that runs detection and tracking. Leave both blank until it is
# deployed: the app boots and every other endpoint works without it, and
# submitting a job returns a clear 502 explaining it is not configured.
#
# PROCESSING_SERVICE_TOKEN must match the token the service expects. It is what
# stops anyone on the internet from spending GPU budget, so treat it like a
# password and never put it in the frontend.
PROCESSING_SERVICE_URL=
PROCESSING_SERVICE_TOKEN=

# Token the processing service must present when reporting job status to
# POST /internal/jobs/status. That route is exempt from user authentication
# because the caller is a machine, so this token is the only thing protecting it.
# Leave blank to reject all callbacks (fails closed). Generate with:
#   openssl rand -hex 32
PROCESSING_CALLBACK_TOKEN=

# ===== Email (optional) =====
# Prefer Gmail SMTP so reset/verification can reach any inbox without DNS.
# Create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Resend is used only when SMTP is unset. A verified domain is required to
# mail arbitrary users; without one Resend only delivers to your own address.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=ScoutAI <noreply@localhost>
APP_PUBLIC_URL=http://localhost:5173

# ===== Google login (optional) =====
# OAuth client ID from Google Cloud. Leave blank to reject /auth/oauth/google.
GOOGLE_CLIENT_ID=
